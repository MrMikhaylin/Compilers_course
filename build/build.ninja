build lib/MC/install-LLVMMC: phony lib/MC/CMakeFiles/install-LLVMMC lib/libLLVMMC.a


#############################################
# Utility command for install-LLVMMC-stripped

build lib/MC/install-LLVMMC-stripped: phony lib/MC/CMakeFiles/install-LLVMMC-stripped lib/libLLVMMC.a


#############################################
# Utility command for package

build lib/MC/CMakeFiles/package.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/MC/package: phony lib/MC/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/MC/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/konstantin/Compilers_course.Task1/build/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/MC/package_source: phony lib/MC/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/MC/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/MC/edit_cache: phony lib/MC/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/MC/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake --regenerate-during-build -S/home/konstantin/Compilers_course.Task1/llvm-project/llvm -B/home/konstantin/Compilers_course.Task1/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/MC/rebuild_cache: phony lib/MC/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/MC/list_install_components: phony


#############################################
# Utility command for install

build lib/MC/CMakeFiles/install.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/MC/install: phony lib/MC/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/MC/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/MC/install/local: phony lib/MC/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/MC/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build lib/MC/install/strip: phony lib/MC/CMakeFiles/install/strip.util


#############################################
# Custom command for lib/MC/CMakeFiles/install-LLVMMC

build lib/MC/CMakeFiles/install-LLVMMC | ${cmake_ninja_workdir}lib/MC/CMakeFiles/install-LLVMMC: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/IR/intrinsics_gen include/llvm/TargetParser/target_parser_gen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMBinaryFormat.a lib/libLLVMDebugInfoDWARFLowLevel.a lib/libLLVMDemangle.a lib/libLLVMMC.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a utils/TableGen/Basic/obj.LLVMTableGenBasic
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMMC" -P /home/konstantin/Compilers_course.Task1/build/cmake_install.cmake
  pool = console


#############################################
# Custom command for lib/MC/CMakeFiles/install-LLVMMC-stripped

build lib/MC/CMakeFiles/install-LLVMMC-stripped | ${cmake_ninja_workdir}lib/MC/CMakeFiles/install-LLVMMC-stripped: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/IR/intrinsics_gen include/llvm/TargetParser/target_parser_gen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMBinaryFormat.a lib/libLLVMDebugInfoDWARFLowLevel.a lib/libLLVMDemangle.a lib/libLLVMMC.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a utils/TableGen/Basic/obj.LLVMTableGenBasic
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMMC" -DCMAKE_INSTALL_DO_STRIP=1 -P /home/konstantin/Compilers_course.Task1/build/cmake_install.cmake
  pool = console

