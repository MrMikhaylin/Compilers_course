build tools/llvm-readtapi/CMakeFiles/install-llvm-readtapi | ${cmake_ninja_workdir}tools/llvm-readtapi/CMakeFiles/install-llvm-readtapi: CUSTOM_COMMAND || bin/llvm-min-tblgen bin/llvm-readtapi bin/llvm-tblgen include/llvm/Analysis/analysis_gen include/llvm/CodeGen/vt_gen include/llvm/IR/intrinsics_gen include/llvm/Support/llvm_vcsrevision_h include/llvm/TargetParser/target_parser_gen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMAsmParser.a lib/libLLVMBinaryFormat.a lib/libLLVMBitReader.a lib/libLLVMBitstreamReader.a lib/libLLVMCodeGenTypes.a lib/libLLVMCore.a lib/libLLVMDebugInfoDWARF.a lib/libLLVMDebugInfoDWARFLowLevel.a lib/libLLVMDemangle.a lib/libLLVMIRReader.a lib/libLLVMMC.a lib/libLLVMMCParser.a lib/libLLVMObject.a lib/libLLVMOption.a lib/libLLVMRemarks.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a lib/libLLVMTextAPI.a lib/libLLVMTextAPIBinaryReader.a tools/llvm-readtapi/ReadTAPIOptsTableGen utils/TableGen/Basic/obj.LLVMTableGenBasic utils/TableGen/Common/obj.LLVMTableGenCommon
  COMMAND = cd /home/konstantin/Compilers_course.Task1/build/tools/llvm-readtapi && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="llvm-readtapi" -P /home/konstantin/Compilers_course.Task1/build/cmake_install.cmake
  pool = console


