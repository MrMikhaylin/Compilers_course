#############################################
# Order-only phony target for llvm-config

build cmake_object_order_depends_target_llvm-config: phony || cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_LLVMTargetParser

build tools/llvm-config/CMakeFiles/llvm-config.dir/llvm-config.cpp.o: CXX_COMPILER__llvm-config_Release /home/konstantin/Compilers_course.Task1/llvm-project/llvm/tools/llvm-config/llvm-config.cpp | tools/llvm-config/BuildVariables.inc || cmake_object_order_depends_target_llvm-config
  DEFINES = -DCMAKE_CFG_INTDIR=\"Release\" -DLLVM_BUILD_STATIC -D_GLIBCXX_USE_CXX11_ABI=1 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/llvm-config/CMakeFiles/llvm-config.dir/llvm-config.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-array-bounds -Wno-stringop-overread -Wno-dangling-pointer -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -O3 -DNDEBUG -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/home/konstantin/Compilers_course.Task1/build/tools/llvm-config -I/home/konstantin/Compilers_course.Task1/llvm-project/llvm/tools/llvm-config -I/home/konstantin/Compilers_course.Task1/build/include -I/home/konstantin/Compilers_course.Task1/llvm-project/llvm/include
  OBJECT_DIR = tools/llvm-config/CMakeFiles/llvm-config.dir
  OBJECT_FILE_DIR = tools/llvm-config/CMakeFiles/llvm-config.dir
  TARGET_COMPILE_PDB = tools/llvm-config/CMakeFiles/llvm-config.dir/
  TARGET_PDB = bin/llvm-config.pdb


